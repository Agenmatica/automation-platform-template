# Local infrastructure only. Copy to .env and change values before exposing it.
# Docker Compose lee el .env desde la carpeta del propio compose.yaml, no
# desde la raíz: copiá este archivo también a infra/<producto>/.env (p. ej.
# infra/kestra/.env, infra/superset/.env) para que las variables se apliquen.
KESTRA_BASIC_AUTH_USERNAME=admin@local.test
KESTRA_BASIC_AUTH_PASSWORD=ChangeMe1Local
KESTRA_DB_PASSWORD=change-me-local
KESTRA_PUBLIC_URL=https://kestra.example.com
SUPERSET_SECRET_KEY=change-me-local-with-at-least-42-characters
SUPERSET_DB_PASSWORD=change-me-local
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-local
SUPERSET_ADMIN_EMAIL=admin@local.test
# Firma los guest tokens de la analítica embebida (spec 007) — distinto de
# SUPERSET_SECRET_KEY a propósito.
SUPERSET_GUEST_TOKEN_JWT_SECRET=change-me-local-with-at-least-42-characters
# Origen del front de Refine, para el CORS de Superset (spec 007).
REFINE_ORIGIN=http://localhost:3100
# Token con permiso "repo" para que infra/runner registre/desregistre el
# self-hosted runner solo. Nunca commitear el valor real, solo este ejemplo.
GH_RUNNER_PAT=ghp_change-me-local

# Supabase Auth en produccion: configurar SMTP externo y sus credenciales en
# el gestor de secretos o Dashboard de Supabase. No incorporar esas credenciales
# ni claves service-role en archivos .env versionados.
