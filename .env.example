# Local infrastructure only. Copy to .env and change values before exposing it.
# Docker Compose lee el .env desde la carpeta del propio compose.yaml, no
# desde la raíz: copiá este archivo también a infra/<producto>/.env (p. ej.
# infra/kestra/.env, infra/superset/.env) para que las variables se apliquen.
KESTRA_BASIC_AUTH_USERNAME=admin@local.test
KESTRA_BASIC_AUTH_PASSWORD=ChangeMe1Local
KESTRA_DB_PASSWORD=change-me-local
KESTRA_PUBLIC_URL=https://kestra.example.com
# Contraseña del rol kestra_backups (spec 011) — mínimo privilegio, solo
# EXECUTE sobre las 3 funciones de respaldo. Se rota por entorno con
# "alter role kestra_backups with password '...'" (research.md R8); la
# migración solo crea el rol con un placeholder, nunca este valor real.
KESTRA_BACKUPS_DB_PASSWORD=change-me-local
# URL JDBC que usan las 3 tareas de public.iniciar_respaldo /
# finalizar_respaldo_completado / finalizar_respaldo_error (spec 011,
# research.md R4) — conexión con el rol kestra_backups, sin privilegio
# más allá de esas 3 funciones. En desarrollo local apunta al mismo
# host:puerto fijo que ya usa pnpm test:db:ci; en staging/producción se
# reemplaza por la cadena propia de ese entorno, solo en su
# infra/kestra/.env (nunca en Git).
KESTRA_BACKUPS_DB_URL=jdbc:postgresql://host.docker.internal:5434/postgres
# Cadena de conexión que usa `pg_dump` en sí (spec 011, research.md
# R3/R4) — necesita leer todas las tablas, algo que kestra_backups
# nunca tiene (research.md R1/R2), así que no reutiliza esa credencial.
# En desarrollo local ya apunta a las credenciales fijas del CLI de
# Supabase (mismo patrón que pnpm test:db:ci); en staging/producción se
# reemplaza por la cadena propia de ese entorno, solo en su
# infra/kestra/.env.
KESTRA_BACKUPS_PGDUMP_URL=postgres://postgres:postgres@host.docker.internal:5434/postgres
# Contraseña del rol kestra_orquestacion (spec 013) — mínimo privilegio,
# EXECUTE acotado a las funciones SECURITY DEFINER de orquestación
# multi-organización. Mismo patrón que KESTRA_BACKUPS_DB_PASSWORD (spec
# 011); no crece con cada organización nueva (FR-008): es un único rol
# para todo Kestra.
KESTRA_ORQUESTACION_DB_PASSWORD=change-me-local
# URL JDBC que usan las tareas de infra/kestra/flows/plantilla-generico.yml
# / plantilla-dedicado.yml (spec 013, research.md R2) — conexión con el rol
# kestra_orquestacion, sin privilegio más allá de sus funciones. Mismo
# host:puerto fijo de desarrollo local por default que KESTRA_BACKUPS_DB_URL;
# en staging/producción se reemplaza por la cadena propia de ese entorno,
# solo en su infra/kestra/.env (nunca en Git).
KESTRA_ORQUESTACION_DB_URL=jdbc:postgresql://host.docker.internal:5434/postgres
# Tope de organizaciones que un flow generico puede despachar en paralelo
# (spec 013, research.md R6). Diez evita saturar Kestra, la base o los VPS;
# cada entorno puede ajustarlo segun su capacidad sin versionar su .env.
KESTRA_ORQUESTACION_CONCURRENCIA=10
# Router HTTP centralizado de las alertas de orquestacion (spec 013). Debe
# recibir tipo, organizacion_id, conexion_id, motivo y destinatarios; enruta
# las tecnicas al operador y las de credencial tambien a los administradores
# de la organizacion. Configurar el valor real solo en infra/kestra/.env.
KESTRA_ALERTAS_WEBHOOK_URL=http://localhost:8099/alertas
SUPERSET_SECRET_KEY=change-me-local-with-at-least-42-characters
SUPERSET_DB_PASSWORD=change-me-local
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me-local
SUPERSET_ADMIN_EMAIL=admin@local.test
# Firma los guest tokens de la analítica embebida (spec 007) — distinto de
# SUPERSET_SECRET_KEY a propósito.
SUPERSET_GUEST_TOKEN_JWT_SECRET=change-me-local-with-at-least-42-characters
# Cuenta de servicio dedicada que usa emitir-acceso-reporte para pedir
# guest tokens (spec 007) — infra/superset/crear_cuenta_servicio_guest_token.py
# la crea en el arranque con el único permiso que necesita
# (can_grant_guest_token), nunca la cuenta interactiva SUPERSET_ADMIN_*.
# Mismos nombres que supabase/functions/.env.example: mismo valor, dos
# mecanismos de despliegue distintos (Compose acá, secrets de Edge
# Functions allá).
SUPERSET_GUEST_TOKEN_USERNAME=guest-token-service
SUPERSET_GUEST_TOKEN_PASSWORD=change-me-local
# Origen del front de Refine, para el CORS de Superset (spec 007).
REFINE_ORIGIN=http://localhost:3100
# Token con permiso "repo" para que infra/runner registre/desregistre el
# self-hosted runner solo. Nunca commitear el valor real, solo este ejemplo.
GH_RUNNER_PAT=ghp_change-me-local

# Supabase Auth en produccion: configurar SMTP externo y sus credenciales en
# el gestor de secretos o Dashboard de Supabase. No incorporar esas credenciales
# ni claves service-role en archivos .env versionados.
