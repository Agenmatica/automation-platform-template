{
  "name": "automation-platform-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:refine",
    "dev:refine": "docker compose -f infra/refine/compose.yaml up -d --build",
    "dev:refine:host": "pnpm --filter @platform/web dev",
    "dev:supabase": "supabase start",
    "dev:kestra": "docker compose -f infra/kestra/compose.yaml up -d",
    "dev:superset": "docker compose -f infra/superset/compose.yaml up -d --build",
    "dev:playwright": "docker compose -f infra/playwright/compose.yaml up -d",
    "dev:runner": "docker compose --env-file .env -f infra/runner/compose.yaml up -d --build",
    "dev:down:refine": "docker compose -f infra/refine/compose.yaml down",
    "dev:down:supabase": "supabase stop --project-id automation-platform-template-supabase-dev",
    "dev:down:kestra": "docker compose -f infra/kestra/compose.yaml down",
    "dev:down:superset": "docker compose -f infra/superset/compose.yaml down",
    "dev:down:playwright": "docker compose -f infra/playwright/compose.yaml down",
    "dev:down:runner": "docker compose -f infra/runner/compose.yaml down",
    "build": "pnpm --filter @platform/web build",
    "lint": "pnpm --filter @platform/web lint",
    "test": "pnpm --filter @platform/web test && pnpm test:db",
    "test:web": "pnpm --filter @platform/web test",
    "test:db": "supabase test db --local",
    "test:db:ci": "PGPASSWORD=postgres PGSSLMODE=disable pg_prove --host host.docker.internal --port ${SUPABASE_DB_PORT:-5434} --username postgres --dbname postgres supabase/tests/database/*.sql",
    "db:reset:ci": "bash scripts/reset-db-ci.sh",
    "preview": "pnpm --filter @platform/web preview",
    "supabase": "supabase",
    "docs:schema": "node scripts/generar-doc-schema.mjs",
    "infra:config": "pnpm infra:config:refine && pnpm infra:config:kestra && pnpm infra:config:superset && pnpm infra:config:playwright && pnpm infra:config:runner",
    "infra:config:refine": "docker compose -f infra/refine/compose.yaml config --quiet",
    "infra:config:kestra": "docker compose -f infra/kestra/compose.yaml config --quiet",
    "infra:config:superset": "docker compose -f infra/superset/compose.yaml config --quiet",
    "infra:config:playwright": "docker compose -f infra/playwright/compose.yaml config --quiet",
    "infra:config:runner": "docker compose -f infra/runner/compose.yaml config --quiet"
  },
  "devDependencies": {
    "supabase": "^2.57.2"
  }
}
